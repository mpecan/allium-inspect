-- Issue #6, as it was filed, and around it: `Fan` iterates `Hooks` and emits
-- `Matched` once per active member, and `Queue` takes each one. A fan-out over
-- a collection with no members matched nothing; the walk used to report
-- `Queue` undecided anyway, because the iteration was never applied. The
-- ones about a hook nobody said was active, a bell nobody hung hooks on and an
-- argument named like a hook's own field are what stays undecided, and say
-- why. A precondition inside a loop is read for each member the filter keeps:
-- decided when every member is known, undecided when one may be missing.

journey NoHooksExist {
    cast:
        c: Clock
    given:
        c.done = false
    1. time passes with no hooks in the world
        stipulate c.is_due = true
        after 1.second
        then c.done = true
}

journey SameFanOutFromAnAct {
    cast:
        c: Clock
    given:
        c.done = false
    1. the same fan-out, started by an act
        c does Poke(c) on Console
        then c.done = true
}

journey OnlyTheActiveHookFires {
    cast:
        c: Clock
        live: Hook
        idle: Hook
    given:
        c.done = false
        live.active = true
        live.fired = false
        live.matched = false
        idle.active = false
        idle.fired = false
        idle.matched = false
    1. time passes with one active hook and one idle one
        stipulate c.is_due = true
        after 1.second
        then live.fired = true
        then idle.fired = false
        then live.matched = true
        then idle.matched = false
}

journey AHookNobodySaidWasActive {
    cast:
        c: Clock
        h: Hook
    given:
        c.done = false
        h.fired = false
    1. a hook whose `active` the journey never set
        c does Poke(c) on Console
        then c.done = true
}

journey AHookNobodySaidWasActiveAndWhatItWouldHaveSetOff {
    cast:
        c: Clock
        h: Hook
    given:
        c.done = false
        h.fired = false
    1. a hook whose `active` the journey never set
        c does Poke(c) on Console
        then Fan fires
        then Queue does not fire
}

journey AHookNobodySaidWasActiveWhileTheClockMoves {
    cast:
        c: Clock
        h: Hook
    given:
        c.done = false
    1. time passes with a hook whose `active` the journey never set
        stipulate c.is_due = true
        after 1.second
}

journey AnArgumentNamedLikeAFieldTheHookHasNotSet {
    cast:
        c: Clock
        h: Hook
    given:
        c.done = false
        h.flagged = false
    1. wave, with a hook whose `active` the journey never set
        c does Wave(c) on Console
}

journey WhatMarkDidNotNeedDoesNotUnsettleIt {
    cast:
        c: Clock
        a: Hook
        b: Hook
    given:
        c.done = false
        c.is_due = true
        a.active = true
    1. mark, deciding everything it ensures from what is set
        c does Mark(c) on Console
        then c.done = true
        then c.marked = true
}

journey APreconditionInsideTheLoopIsNotTheArgument {
    cast:
        h: Hook
        idle: Hook
    given:
        h.active = true
        h.swept = false
        idle.active = false
    1. check a hook, whose loop is named like the argument
        h cannot do Check(h) on Panel
}

journey APreconditionInsideTheLoopOverNoHooks {
    cast:
        c: Clock
    given:
        c.done = false
    1. muster with no hooks in the world
        c does Muster(c) on Console
        then c.done = true
}

journey EveryArmedHookIsActive {
    cast:
        c: Clock
        live: Hook
        idle: Hook
    given:
        c.done = false
        live.armed = true
        live.active = true
        live.swept = false
        idle.armed = false
        idle.active = false
        idle.swept = false
    1. muster: the only armed hook is active, and the idle one is not kept
        c does Muster(c) on Console
        then c.done = true
        then live.swept = true
        then idle.swept = false
}

journey AnArmedHookIsNotActive {
    cast:
        c: Clock
        live: Hook
        dead: Hook
    given:
        c.done = false
        live.armed = true
        live.active = true
        live.swept = false
        dead.armed = true
        dead.active = false
    1. muster: one armed hook is not active, so the whole rule refuses
        c cannot do Muster(c) on Console
        then c.done = false
        then live.swept = false
}

journey AnArmedHookNobodySaidWasActive {
    cast:
        c: Clock
        h: Hook
    given:
        c.done = false
        h.armed = true
    1. muster: an armed hook whose `active` nobody set
        c does Muster(c) on Console
}

journey ARackWithItsHookHung {
    cast:
        r: Rack
        h: Hook
    given:
        r.hung = false
        h.rack = r
        h.active = true
        h.swept = false
    1. hang a rack whose one hook is active
        r does Hang(r) on Workshop
        then r.hung = true
        then h.swept = true
}

journey ARackThatMayBeMissingAHook {
    cast:
        r: Rack
        h: Hook
    given:
        r.hung = false
        h.active = true
    1. hang a rack whose hook may or may not be on it
        r does Hang(r) on Workshop
}

journey ARackThatMayBeMissingAHookHoldsAnInactiveOne {
    cast:
        r: Rack
        on: Hook
        loose: Hook
    given:
        r.hung = false
        on.rack = r
        on.active = false
        loose.active = true
    1. hang a rack holding an inactive hook, whatever else is on it
        r cannot do Hang(r) on Workshop
}

journey SweepWritesEachMember {
    cast:
        c: Clock
        live: Hook
        idle: Hook
    given:
        c.done = false
        live.active = true
        live.swept = false
        idle.active = false
        idle.swept = false
    1. sweep
        c does Sweep(c) on Console
        then live.swept = true
        then idle.swept = false
        then c.done = true
}

journey ABellNobodyHungHooksOn {
    cast:
        b: Bell
    given:
        b.rung = false
    1. ring a bell whose hooks the journey never said
        b does Ring(b) on Belfry
        then b.rung = true
}

journey ABellWhoseHookIsActive {
    cast:
        b: Bell
        h: Hook
    given:
        b.rung = false
        b.hooks = {h}
        h.active = true
        h.swept = false
    1. toll a bell whose one hook is active
        b does Toll(b) on Belfry
        then b.rung = true
        then h.swept = true
}

journey ABellWhoseHookIsNotActive {
    cast:
        b: Bell
        h: Hook
    given:
        b.rung = false
        b.hooks = {h}
        h.active = false
    1. toll a bell whose one hook is inactive
        b cannot do Toll(b) on Belfry
}
