-- Issue #11, as filed: behaviour that is off by default, walked switched on.

journey ConfigInGiven {
    cast:
        r: Repo
    given:
        config.lfs_enabled = true
    1. use LFS on an instance that enabled it
        r does UseLfs(r) on Settings
        then r.lfs_used = true
}

journey ConfigInStep {
    cast:
        r: Repo
    1. use LFS on an instance that enabled it
        stipulate config.lfs_enabled = true
        r does UseLfs(r) on Settings
        then r.lfs_used = true
}

journey ByDefaultItIsOff {
    cast:
        r: Repo
    1. LFS is refused where nobody turned it on
        r cannot do UseLfs(r) on Settings
}
