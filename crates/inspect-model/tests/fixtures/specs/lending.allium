-- allium: 3
-- lending.allium
--
-- The fixture half that owns *what happens to a copy in someone's hands*.
--
-- It exists to give the linker something real to resolve: every reference below
-- of the form `catalogue/Copy` has to become an edge into the other module, and
-- an unresolved one has to become a visible External node rather than vanish.

use "./catalogue.allium" as catalogue

------------------------------------------------------------
-- Value types and sum types
------------------------------------------------------------

value LoanWindow {
    opened_at: Timestamp
    due_at: Timestamp
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Member {
    name: String
    joined_at: Timestamp

    loans: Loan with member = this
    open_loans: loans where status = open
    open_loan_count: open_loans.count
    is_at_limit: open_loan_count >= config.loan_limit
}

entity Loan {
    copy: catalogue/Copy
    member: Member
    window: LoanWindow

    status: open | returned | overdue

    transitions status {
        open -> returned
        open -> overdue
        overdue -> returned
        terminal: returned
    }

    is_late: window.due_at <= now
}

-- What a chained rule makes. Nothing fires `NoteTheBorrowing` directly:
-- `BorrowCopy` emits `CopyBorrowed` and it waits on that, which is the
-- ordinary shape once a spec has more than one concern — and the shape a
-- journey could not reach while the walk stopped at the act's own rule.
entity Notice {
    loan: Loan
    raised_at: Timestamp
}

entity Reservation {
    book: catalogue/Book
    member: Member
    placed_at: Timestamp

    -- Typed by an enumeration declared elsewhere rather than by states of its
    -- own, which is the ordinary shape once two constructs share a vocabulary
    -- — and the shape whose states used to be invisible to the simulator.
    wanted_as: catalogue/Medium

    status: waiting | fulfilled | cancelled

    transitions status {
        waiting -> fulfilled
        waiting -> cancelled
        terminal: fulfilled
        terminal: cancelled
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    loan_limit: Integer = 5
    loan_period: Duration = 21.days
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule BorrowCopy {
    when: MemberBorrows(member, copy)

    requires: copy.status = available
    requires: not member.is_at_limit

    ensures: Loan.created(
        copy: copy,
        member: member,
        status: open
    )

    ensures: copy.status = on_loan
    ensures: CopyBorrowed(loan: loan)
}

rule ReturnCopy {
    when: MemberReturns(loan)

    requires: loan.status = open or loan.status = overdue

    ensures: loan.status = returned
    ensures: loan.copy.status = available
    ensures: CopyReturned(loan: loan)
}

-- The optional parameter in the set. `note?` is what a caller usually does not
-- pass, and a rule guarding it against `null` has to be reachable by the
-- callers who do not.
rule ReportCopyLost {
    when: MemberReportsLoss(loan, note?)

    requires: loan.status = open
    requires: note = null or note != ""

    ensures: loan.copy.status = lost
    ensures: loan.status = returned
}

-- A temporal state-condition trigger. Nothing external fires it; the clock
-- passing the due date is what makes it hold.
rule LoanFallsOverdue {
    when: loan: Loan.window.due_at <= now

    requires: loan.status = open

    ensures: loan.status = overdue
    ensures: LoanOverdue(loan: loan)
}

-- One hop past the act, with no preconditions of its own — so a journey that
-- cannot see it is not being told about a rule that failed, but about one that
-- never ran.
rule NoteTheBorrowing {
    when: CopyBorrowed(loan)

    ensures: Notice.created(
        loan: loan,
        raised_at: now
    )
}

rule PlaceReservation {
    when: MemberReserves(member, book)

    requires: book.status = listed

    ensures: Reservation.created(
        book: book,
        member: member,
        placed_at: now,
        wanted_as: print,
        status: waiting
    )
}

-- The call this set has that nothing defines. `may_reserve` is a policy
-- decision nobody has taken, which is an ordinary state for a specification to
-- be in and a permanent one for a simulator: there is nothing to work out. A
-- journey says what it comes back as, and says it on the record.
rule ReserveQuietly {
    when: MemberReservesQuietly(member, book)

    requires: may_reserve(member, book)

    ensures: Reservation.created(
        book: book,
        member: member,
        placed_at: now,
        status: waiting
    )
}

-- A `let` naming something the act's own arguments determine, read by both
-- halves of the rule. The shape three of `friend-mesh`'s four contact-naming
-- rules use, and the one whose binding was dropped between the parser and the
-- program — so `requires` evaluated a name nothing had bound and the whole
-- surface came back undecided.
rule WithdrawReservation {
    when: MemberWithdrawsReservation(member, book)

    let standing = Reservation{member: member, book: book}

    requires: exists standing

    ensures: standing.status = cancelled
}

rule CancelReservationOnWithdrawal {
    when: reservation: Reservation.book.status = withdrawn

    requires: reservation.status = waiting

    ensures: reservation.status = cancelled
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OpenLoansAreWithinTheLimit {
    for m in Members:
        m.open_loan_count <= config.loan_limit
}

invariant AReturnedLoanFreesItsCopy {
    for l in Loans:
        l.status = returned implies l.copy.status != on_loan
}

invariant OverdueLoansArePastTheirDueDate {
    for l in Loans:
        l.status = overdue implies l.is_late
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

actor Reader {
    identified_by: Member where open_loan_count >= 0
}

-- A shelf scoped to the person reading it, beside `MemberShelf`, which is not.
--
-- The pair is the point. `MemberShelf` exposes `Loan.status` over the *type*,
-- so it shows every loan to everyone it faces — and carries a `@guarantee`
-- four lines below saying it does no such thing. This one says in its
-- `exposes` clause what that one says in prose, and the difference is that a
-- journey can tell them apart.
surface MyLoans {
    facing reader: Reader
    context borrower: Member

    exposes:
        borrower.name
        for loan in borrower.open_loans:
            loan.status
            -- Two hops from the thing being iterated, which is the ordinary
            -- shape once a spec has more than one noun: what is on the shelf
            -- is the copy, and a reader looking for it names the copy rather
            -- than the loan it happens to hang off.
            loan.copy.shelfmark

    provides:
        MemberReturns(loan)

    @guarantee AShelfShowsItsOwnerTheirOwnLoans
        -- Written in the clause above rather than only here, which is what
        -- makes it something other than a wish.
}

surface MemberShelf {
    facing reader: Reader

    exposes:
        -- A call, which is a thing a surface may expose and a thing no field
        -- can stand for: whether this reader is in good standing is a question
        -- about them rather than a value written down anywhere.
        in_good_standing(reader)
        Loan.status
        Loan.is_late
        Member.open_loan_count

    provides:
        MemberBorrows(reader, copy)
        MemberReturns(loan)
        MemberReportsLoss(loan, note?)
        MemberReserves(reader, book)
        MemberReservesQuietly(reader, book)
        MemberWithdrawsReservation(reader, book)

    @guarantee ALoanIsVisibleToItsHolderOnly
        -- A shelf shows the reader their own loans. Whose copy is out is a
        -- fact about another member, and this boundary does not carry it.
}
